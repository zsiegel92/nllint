# Use a runtime login granted nllint_runtime. Initialize schema separately.
DATABASE_URL=postgresql://nllint_login@127.0.0.1/nllint
NLLINT_APP_URL=http://localhost:8080

# Generate with: openssl rand -hex 32
NLLINT_SESSION_SECRET=

# Generate with: openssl rand -base64 32 | tr '/+' '_-'
NLLINT_PROVIDER_ENCRYPTION_KEY=

TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Set GitHub values for a hosted deployment.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USER_IDS=

# Local development only, with GitHub settings left empty.
# Generate with: openssl rand -hex 32
# NLLINT_ADMIN_TOKEN=

# Optional
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# NLLINT_DECISION_MODEL=jev-latest
# NLLINT_RANGE_BASE_URL=https://openrouter.ai/api/v1
# NLLINT_RANGE_MODEL=openai/gpt-6-luna
# NLLINT_RANGE_SERVICE_TIER=flex
# NLLINT_ALLOWED_PROVIDER_BASE_URLS=https://models.example.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROJECT_ID=
# NLLINT_CACHE_EPOCH=1
# NLLINT_WORKER_SLOTS=4
# NLLINT_DECISION_REQUESTS_PER_MINUTE=120
# NLLINT_RANGE_REQUESTS_PER_MINUTE=60
# NLLINT_ANNOTATION_DELAY_SECONDS=60
# NLLINT_WORKER_ENABLED=true
# DATABASE_MIGRATION_URL=
# NLLINT_REMOTE_DEV_ORIGIN=http://localhost:5175
